require("dotenv").config();
const express = require("express");
const rateLimit = require("express-rate-limit");
const helmet = require("helmet");
const cors = require("cors");
const { Readable } = require("stream");
const fetch = (...args) => import("node-fetch").then(({default: fetch}) => fetch(...args));

const app = express();
app.use(helmet());
app.use(cors());
app.use(express.urlencoded({ extended: true }));
app.use(express.json());

// Load env
const apiKey = process.env.ELEVENLABS_API_KEY_TEST;   // 👈 use TEST key
const voices = JSON.parse(process.env.ELEVENLABS_VOICES_JSON || "{}");

app.post("/tts", async (req, res) => {
  try {
    const voiceName = req.body.voice || req.query.voice || "YoungGirl"; // 👈 default to YoungGirl
    const text = req.body.text || req.query.text;
    const useSSML = req.body.use_ssml || req.query.use_ssml;

    if (!text) {
      return res.status(400).json({ error: "Missing text" });
    }

    const voiceId = voices[voiceName];
    if (!voiceId) {
      return res.status(400).json({ error: `Unknown voice: ${voiceName}` });
    }

    const response = await fetch(`https://api.elevenlabs.io/v1/text-to-speech/${voiceId}`, {
      method: "POST",
      headers: {
        "xi-api-key": apiKey,
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        text,
        model_id: "eleven_multilingual_v2",
        use_ssml: !!useSSML,
        voice_settings: { stability: 0.4, similarity_boost: 0.8 },
        output_format: "mp3_44100_128"
      })
    });

    if (!response.ok) {
      const errTxt = await response.text();
      console.error("ElevenLabs error:", response.status, errTxt);
      return res.status(response.status).json({ error: "elevenlabs_error", detail: errTxt });
    }

    res.setHeader("Content-Type", "audio/mpeg");
    Readable.fromWeb(response.body).pipe(res);

  } catch (err) {
    console.error("Server error:", err);
    if (!res.headersSent) res.status(500).json({ error: "server_error" });
  }
});

const port = Number(process.env.PORT || 8080);
app.listen(port, "0.0.0.0", () => {
  console.log(`Bible PAL proxy listening on :${port}`);
});