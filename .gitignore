/android/app/debug
/android/app/profile
/android/app/release
# secrets
.env
**/*.env
server/node_modules/

.DS_Store

# Bible PAL generated audio + temp stitching
assets/stories/*.mp3
assets/stories/temp_segments/
assets/stories/temp_segments/**
assets/stories/.temp_generation/
assets/stories/.temp_generation/**

# ALLOW 500-series and 800-series audio (needed for app build)
!assets/stories/creative/**/*.mp3
!assets/stories/traditional/**/*.mp3

# Bible PAL generation quarantine (failed stories)
assets/stories_failed/

# Server generation logs, mode lock, and nightly state
server/logs/
server/.nightly_state

# Temporary/superseded story generation scripts
server/tools/fix_story_files.py
server/tools/regenerate_trad_stories.py
server/tools/regenerate_with_continuation.py
server/tools/generation_practice_run.sh

# Root-level TTS test outputs
bp_*.mp3

# One-off test directories
audio_tests/

# Test audio assets (not needed for production)
assets/audio/pal_test_greeting*.mp3
assets/audio/typewriter_click.mp3

# Quarantined story batches (compliance violations)
quarantine/

# Audio compression working directories (originals backup + intermediate output)
assets_audio_originals/
assets_audio_compressed/

# Wrangler local config
.wrangler/

# Android build script temporary backup
.android_build_backup_*

# Ruth v2 experimental audio — generated locally for the
# 2026-04-25 voice-stability test, intentionally not bundled or
# committed. Files are preserved on disk for any future
# regeneration / replacement-voice work.
assets/pal/audio/VOICE_RUTH_COMFORT_V2/

# Local WIP snapshots — produced when intentionally pushing committed
# work while leaving an in-progress working tree (e.g. PAL opening
# retirement). Always local, never committed.
wip-*-status.txt
