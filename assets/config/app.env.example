# Bundled client config — generated by scripts/gen_app_env.sh from the dev .env.
#
# Contains ONLY the keys the Flutter app reads at runtime. NEVER add pipeline
# secrets (ANTHROPIC_API_KEY, CLOUDFLARE_API_TOKEN) or VOICE_* ids here — they
# must never ship inside the app binary. The real generated file (app.env) is
# gitignored; this .example documents its shape.
AUDIO_BASE_URL=https://your-r2-public-url.r2.dev
ELEVENLABS_API_KEY=your-elevenlabs-key
